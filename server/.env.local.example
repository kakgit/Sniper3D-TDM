# Copy this file to server/.env.local and put your own local Postgres in it.
#
#   cp server/.env.local.example server/.env.local
#
# server/.env.local is gitignored, so the password stays on this machine and out
# of git history and out of any chat. Do not commit the real file.
#
# The smoke test reads it automatically, so this is the whole workflow:
#
#   python server/smoke_test.py
#
# Replace tdm and CHANGE_ME with the role and password you created, and keep the
# rest if your Postgres is the default local install on port 5432.
DATABASE_URL=postgresql://tdm:CHANGE_ME@127.0.0.1:5432/tdm_accounts
